<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="100%" height="100%">
  <defs>
    <!-- Background Rich Teal Gradient -->
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#14b8a6" />
      <stop offset="25%" stop-color="#0d9488" />
      <stop offset="65%" stop-color="#0f766e" />
      <stop offset="100%" stop-color="#042f2e" />
    </linearGradient>

    <!-- Top Gloss Arc Gradient -->
    <linearGradient id="glossGrad" x1="50%" y1="0%" x2="50%" y2="100%">
      <stop offset="0%" stop-color="#ffffff" stop-opacity="0.3" />
      <stop offset="100%" stop-color="#ffffff" stop-opacity="0" />
    </linearGradient>

    <!-- Minted Gold Coin Gradient -->
    <linearGradient id="coinGrad" x1="20%" y1="10%" x2="85%" y2="90%">
      <stop offset="0%" stop-color="#fef08a" />
      <stop offset="28%" stop-color="#fbbf24" />
      <stop offset="70%" stop-color="#d97706" />
      <stop offset="100%" stop-color="#92400e" />
    </linearGradient>

    <!-- Coin Bevel Highlight -->
    <linearGradient id="rimGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#ffffff" stop-opacity="0.85" />
      <stop offset="100%" stop-color="#78350f" stop-opacity="0.5" />
    </linearGradient>

    <!-- Drop Shadows for 3D Pop -->
    <filter id="shadowRoof" x="-20%" y="-20%" width="140%" height="140%" filterUnits="userSpaceOnUse">
      <feDropShadow dx="0" dy="10" stdDeviation="12" flood-color="#021c1b" flood-opacity="0.5" />
    </filter>

    <filter id="shadowCoin" x="-25%" y="-25%" width="150%" height="150%" filterUnits="userSpaceOnUse">
      <feDropShadow dx="0" dy="12" stdDeviation="14" flood-color="#021c1b" flood-opacity="0.5" />
    </filter>

    <filter id="shadowCheck" x="-20%" y="-20%" width="140%" height="140%" filterUnits="userSpaceOnUse">
      <feDropShadow dx="0" dy="3" stdDeviation="3" flood-color="#78350f" flood-opacity="0.6" />
    </filter>
  </defs>

  <!-- 1. Base Squircle -->
  <rect width="512" height="512" rx="124" fill="url(#bgGrad)" />

  <!-- 2. Inner Rim Stroke -->
  <rect x="12" y="12" width="488" height="488" rx="112" fill="none" stroke="rgba(255,255,255,0.22)" stroke-width="5" />

  <!-- 3. Ambient Top-Light Gloss -->
  <path d="M 12 136 C 12 68, 68 12, 136 12 L 376 12 C 444 12, 500 68, 500 136 C 500 216, 368 256, 256 256 C 144 256, 12 216, 12 136 Z" fill="url(#glossGrad)" />

  <!-- 4. House Roof & Chimney -->
  <g filter="url(#shadowRoof)">
    <!-- Chimney -->
    <path
      d="M 342 168 L 342 136 C 342 131, 346 127, 351 127 L 361 127 C 366 127, 370 131, 370 136 L 370 192"
      fill="none"
      stroke="#ffffff"
      stroke-width="18"
      stroke-linecap="round"
      stroke-linejoin="round"
      opacity="0.95"
    />
    <!-- Roof Gable -->
    <path
      d="M 116 236 L 256 120 L 396 236"
      fill="none"
      stroke="#ffffff"
      stroke-width="44"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </g>

  <!-- 5. Golden Kas / Dues Coin -->
  <g filter="url(#shadowCoin)">
    <!-- Solid Gold Coin Base -->
    <circle cx="256" cy="336" r="98" fill="url(#coinGrad)" />
    <!-- Outer Rim Bevel -->
    <circle cx="256" cy="336" r="98" fill="none" stroke="url(#rimGrad)" stroke-width="3.5" />
    <!-- Minted Stippled Inner Ring -->
    <circle cx="256" cy="336" r="86" fill="none" stroke="url(#rimGrad)" stroke-width="3" stroke-dasharray="8 6" opacity="0.8" />

    <!-- 6. Crisp Verification Checkmark inside Coin -->
    <path
      d="M 216 336 L 244 364 L 302 304"
      fill="none"
      stroke="#ffffff"
      stroke-width="24"
      stroke-linecap="round"
      stroke-linejoin="round"
      filter="url(#shadowCheck)"
    />
  </g>

  <!-- 7. Dynamic Sparkle Accent (Top-Right of Roof) -->
  <g transform="translate(396, 108)">
    <path
      d="M 0 -16 Q 0 0, 16 0 Q 0 0, 0 16 Q 0 0, -16 0 Q 0 0, 0 -16 Z"
      fill="#fef08a"
      opacity="0.9"
    />
  </g>
</svg>
