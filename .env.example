# ==============================================================================
# RT Dues System - Environment Variables (Vercel + Neon Postgres)
# ==============================================================================

# 1. Neon Database URL (Dapatkan dari neon.tech -> Dashboard -> Connection Details)
# Pilih mode "Pooled connection" atau "Direct connection" (keduanya didukung oleh driver Neon Serverless)
DATABASE_URL=postgresql://neondb_owner:your_password@ep-cool-sample.us-east-2.aws.neon.tech/neondb?sslmode=require

# 2. Secret Key untuk Autentikasi Admin Sesi (Buat string acak, misal: openssl rand -base64 32)
AUTH_SECRET=buat_kunci_rahasia_acak_minimal_32_karakter_bebas

# 3. URL Domain Aplikasi
# Di lokal: http://localhost:3000
# Di Vercel: https://nama-proyek-anda.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
